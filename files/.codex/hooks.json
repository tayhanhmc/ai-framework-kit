{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --isolated --no-config --no-project --python \">=3.11\" -- python \"$(git rev-parse --show-toplevel)/ai/scripts/garden.py\" --session"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --isolated --no-config --no-project --python \">=3.11\" -- python \"$(git rev-parse --show-toplevel)/ai/scripts/format_changed.py\""
          }
        ]
      }
    ]
  }
}